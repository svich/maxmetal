# Compiles every .metal file in DIR with the Metal compiler: ctest's metal_compile test (after the translate test,
# which writes them). Usage: cmake -DDIR=<dir> -P metal_compile.cmake
file(GLOB files "${DIR}/*.metal")
list(LENGTH files n)
if(n EQUAL 0)
  message(FATAL_ERROR "no .metal files in ${DIR} (the translate test writes them)")
endif()
set(failed 0)
foreach(f IN LISTS files)
  execute_process(COMMAND xcrun -sdk macosx metal -c -w ${f} -o /dev/null RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message("FAIL ${f}\n${err}")
    math(EXPR failed "${failed} + 1")
  endif()
endforeach()
if(failed)
  message(FATAL_ERROR "${failed} of ${n} did not compile")
endif()
message("${n} compiled")
